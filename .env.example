# =============================================================================
# SISPAT-AGU — .env.example
# =============================================================================
# Copie este arquivo para ".env" e preencha com valores REAIS apenas no seu
# ambiente local/seguro. NUNCA versionar o arquivo ".env" (já listado no
# .gitignore). Nenhum valor real deve existir neste arquivo de exemplo.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados — Supabase/PostgreSQL (fonte operacional remota)
# -----------------------------------------------------------------------------
# String de conexão completa usada pelo SQLAlchemy/Alembic no backend Flask.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# URL do projeto Supabase (ex.: https://tocbtonqnahmtegfkrmn.supabase.co)
SUPABASE_URL=

# NUNCA expor no frontend/Next.js público. Uso exclusivo do backend Flask
# (operações privilegiadas, bypass de RLS quando estritamente necessário).
SUPABASE_SERVICE_ROLE_KEY=

# Chave anônima/pública do Supabase (uso restrito e sempre validado no backend).
SUPABASE_ANON_KEY=

# Validação de JWT do Supabase Auth no backend (ver backend/app/config/settings.py).
# Segredo JWT do projeto (Settings > API > JWT). SEGREDO — nunca versionar.
# Em produção (FLASK_ENV=production) exige >= 32 caracteres, senão a API não sobe.
# Se definido vazio também falha: descomente apenas com o valor real.
# SUPABASE_JWT_SECRET=<segredo-jwt-do-projeto-min-32-caracteres>
# Algoritmos JWT aceitos (allowlist HS256,ES256; padrão ambos). O projeto atual
# assina com ES256 (JWKS público). Com apenas ES256, SUPABASE_JWT_SECRET é
# ignorado/dispensável (desliga o segredo HS256 legado).
SUPABASE_JWT_ALGORITHMS=HS256,ES256
# JWKS: vazio => <SUPABASE_URL>/auth/v1/.well-known/jwks.json (HTTPS em produção).
SUPABASE_JWKS_URL=
# TTL do cache do JWKS (s; 30–86400) e timeout da busca (s; padrão 3).
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_JWKS_TIMEOUT_SECONDS=3
# Claim `aud` exigido (padrão: authenticated).
SUPABASE_JWT_AUDIENCE=authenticated
# Claim `iss` exigido. Vazio => derivado de SUPABASE_URL (<SUPABASE_URL>/auth/v1).
SUPABASE_JWT_ISSUER=
# Tolerância de relógio (s) para exp/nbf/iat. Padrão 30; faixa 0–300.
JWT_LEEWAY_SECONDS=30

# URLs permitidas como redirect de convite (separadas por vírgula).
# O PRIMEIRO item é o destino do convite (redirect_to) e DEVE terminar em
# /ativar-conta (o backend recusa o convite caso contrário). Ele precisa estar
# também em Supabase Auth > URL Configuration > Redirect URLs e é o valor de
# {{ .RedirectTo }} no template de e-mail (docs/deploy/email-template-convite.md).
# Em produção use o domínio final com HTTPS, ex.: https://patrimonio.exemplo.gov.br/ativar-conta
INVITE_ALLOWED_REDIRECT_URLS=http://localhost:3000/ativar-conta
# Tela do frontend que recebe o link de recuperação de senha (enviado pelo
# próprio Supabase; o ADM nunca vê o link). Precisa estar também em
# INVITE_ALLOWED_REDIRECT_URLS. Vazio => usa a primeira URL daquela lista.
PASSWORD_RESET_REDIRECT_URL=
# Limite de corpo de requisição no Flask (bytes; padrão 1 MiB, mínimo 1024).
# Mantenha <= client_max_body_size do Nginx (infra/cloudpanel/vhost.conf.example).
MAX_CONTENT_LENGTH_BYTES=1048576

# TLS do PostgreSQL (lidos por app.database.session). Recomendado em produção:
# DB_SSLMODE=verify-full com a CA do Supabase em DB_SSLROOTCERT (caminho no
# container, montado como arquivo/secret — nunca o conteúdo aqui).
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/run/secrets/supabase-ca.crt

# Pool de conexões do SQLAlchemy (app.database.session; valores padrão).
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

# Em FLASK_ENV=production, INVITE_ALLOWED_REDIRECT_URLS e CORS_ALLOWED_ORIGINS
# aceitam apenas https:// (o backend falha no startup caso contrário).

# -----------------------------------------------------------------------------
# Backend Flask
# -----------------------------------------------------------------------------
# development | production
FLASK_ENV=production

# Chave secreta da aplicação Flask (sessões, tokens, assinaturas). Gerar uma
# chave forte e aleatória por ambiente; nunca reutilizar entre ambientes.
# Em produção exige >= 32 caracteres (ex.: `openssl rand -hex 32`).
SECRET_KEY=

# -----------------------------------------------------------------------------
# Redis (cache / broker do worker Celery/RQ)
# -----------------------------------------------------------------------------
# Senha OBRIGATÓRIA do Redis (docker-compose.yml recusa subir sem ela).
# Use apenas caracteres [A-Za-z0-9] (ex.: `openssl rand -hex 32`).
REDIS_PASSWORD=
# A URL deve conter a MESMA senha. Linha comentada de propósito: descomente e
# SUBSTITUA o trecho SENHA pelo valor de REDIS_PASSWORD (sem os sinais < >):
# REDIS_URL=redis://:SENHA@redis:6379/0
# Conferência: `grep -n '<' .env` deve voltar vazia e REDIS_URL deve existir.

# Broker e result backend do Celery (worker com beat embutido). Ausentes =>
# usam REDIS_URL. Defina apenas se precisar de bancos Redis separados.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# Arquivo de estado do beat (caminho ABSOLUTO, sem '..'). Padrão:
# /tmp/celerybeat-schedule, no tmpfs privado do container read_only do worker.
# Fora do container, aponte para um diretório do próprio app (não compartilhado).
# CELERY_BEAT_SCHEDULE_FILENAME=

# -----------------------------------------------------------------------------
# Integração Google Sheets
# -----------------------------------------------------------------------------
# Caminho do arquivo de credenciais JSON (service account). NÃO colar o
# conteúdo do JSON aqui — apenas o caminho.
# - Docker: o docker-compose.yml SOBREPÕE esta variável com
#   /run/secrets/google_sheets_credentials.json (montagem somente leitura).
# - Fora do Docker (flask run local): caminho do arquivo no HOST.
GOOGLE_SHEETS_CREDENTIALS_JSON=/run/secrets/google_sheets_credentials.json

# Docker: caminho no HOST do JSON da service account (FORA do repositório).
# O Compose o monta como secret somente leitura no backend e no worker.
# Ex. Windows: C:/Users/<usuario>/credenciais/service-account.json
# Ex. VPS:     /etc/sispat-agu/google_sheets_credentials.json (0400)
# Padrão se ausente: ./secrets/google_sheets_credentials.json (ignorado pelo git).
# Comentada de propósito: um placeholder literal quebraria `docker compose up`.
# Descomente apenas com um caminho real que exista no host.
# GOOGLE_SHEETS_CREDENTIALS_HOST_PATH=/etc/sispat-agu/google_sheets_credentials.json

# ID da planilha de origem (Google Sheets) usada na sincronização inicial.
# Descomente e preencha com o ID real (trecho entre /d/ e /edit na URL).
# GOOGLE_SHEETS_SPREADSHEET_ID=

# Timeout (s) das chamadas à Google Sheets API (1–300). Ausente => padrão do cliente.
# GOOGLE_SHEETS_TIMEOUT_SECONDS=30

# Timeouts em cascata (docs/deployment/timeouts-gunicorn.md): mantenha todos
# MENORES que o --timeout do gunicorn (180 s). Statement timeout é opt-in
# (pooler em modo transação pode rejeitar); 120000 ms recomendado.
# DB_STATEMENT_TIMEOUT_MS=120000
# GUNICORN_CMD_ARGS=--timeout 180

# Aba a ser lida: título exato (prioridade) OU o GID numérico da aba. Opcionais.
# GOOGLE_SHEETS_SHEET_NAME=
# GOOGLE_SHEETS_SHEET_GID=

# Abas dos cadastros de apoio (importação de Unidades/Salas/Pessoas). Para cada
# cadastro informe o nome exato (prioridade) OU o GID. Opcionais: sem valor, a
# importação daquele cadastro recusa executar (nunca assume uma aba).
# GOOGLE_SHEETS_UNITS_SHEET_NAME=
# GOOGLE_SHEETS_UNITS_SHEET_GID=
# GOOGLE_SHEETS_ROOMS_SHEET_NAME=
# GOOGLE_SHEETS_ROOMS_SHEET_GID=
# GOOGLE_SHEETS_PEOPLE_SHEET_NAME=
# GOOGLE_SHEETS_PEOPLE_SHEET_GID=

# -----------------------------------------------------------------------------
# Inteligência Artificial (consultiva, somente leitura) — DESLIGADA por padrão
# -----------------------------------------------------------------------------
# AI_ENABLED=false vence qualquer configuração feita na tela de Configurações.
# Chaves: SEGREDOS do backend. Nunca no banco, no frontend (sem NEXT_PUBLIC_),
# em logs ou respostas da API. Deixe vazio o provedor que não for usado.
AI_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DeepSeek: exige aceite do ADM sobre transferência internacional (LGPD).
DEEPSEEK_API_KEY=
# Timeout (s) por chamada; máximo de tokens de saída por chamada.
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=800
# Limites por hora (por usuário / por unidade).
AI_RATE_LIMIT_PER_USER=20
AI_RATE_LIMIT_PER_UNIT=100
# Teto global de tokens por mês (o menor entre este e o da tela vale).
AI_MONTHLY_TOKEN_CAP=200000
# Circuit breaker: falhas consecutivas que abrem o circuito e duração (s).
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_OPEN_SECONDS=300

# Alertas determinísticos do dashboard (limites das regras; todos opcionais).
ALERTS_UNCHECKED_DAYS=365
ALERTS_NO_MOVEMENT_DAYS=365
ALERTS_SPIKE_BASELINE_WEEKS=8
ALERTS_SPIKE_SIGMA=3.0
ALERTS_SPIKE_MIN_COUNT=5
# ALERTS_PATRIMONY_REGEX=^[0-9A-Za-z][0-9A-Za-z./-]{0,31}$

# -----------------------------------------------------------------------------
# E-mail SMTP (backend/worker apenas) — DESLIGADO por padrão
# -----------------------------------------------------------------------------
# Nunca no frontend (sem NEXT_PUBLIC_). EMAIL_PASSWORD é SEGREDO: só no .env
# local não versionado / secret do servidor; nunca em log, banco ou resposta.
# Convites e recuperação de senha continuam saindo pelo SMTP do Supabase Auth.
# Gmail: exige verificação em duas etapas + SENHA DE APP (espaços são ignorados);
# EMAIL_FROM deve ser a conta autenticada (ou alias verificado); ~500 msgs/dia.
# Porta 587 + starttls, ou 465 + ssl. Porta 25/texto claro é recusada.
EMAIL_ENABLED=false
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_FROM=
# EMAIL_FROM_NAME=
# EMAIL_SECURITY=starttls
# EMAIL_TIMEOUT_SECONDS=10
# Domínios de destinatário permitidos (CSV); vazio = qualquer.
# EMAIL_ALLOWED_RECIPIENT_DOMAINS=
# Teto global de e-mails por hora (exige Redis; sem Redis o envio é bloqueado).
# EMAIL_MAX_PER_HOUR=30

# -----------------------------------------------------------------------------
# n8n (instância EXTERNA já existente — NÃO instalada por este projeto)
# -----------------------------------------------------------------------------
# Este projeto NÃO roda um n8n local (ver docker-compose.yml). A automação de
# workflows consome uma instância de n8n EXTERNA já existente, administrada
# fora deste repositório. As variáveis abaixo são usadas apenas pelo cliente
# HTTP do backend (implementação em backend/app/integrations/, fora do escopo
# deste arquivo) para falar com essa instância externa.
#
# NUNCA expor estas variáveis ao frontend/Next.js público (nenhuma delas deve
# ter o prefixo NEXT_PUBLIC_). A comunicação com o n8n externo é exclusiva do
# backend Flask. HTTPS é obrigatório — N8N_BASE_URL/N8N_WEBHOOK_URL nunca
# devem apontar para http:// em produção. A integração vem DESLIGADA por
# padrão (N8N_INTEGRATION_ENABLED=false) até ser explicitamente habilitada.

# URL base da API do n8n externo (ex.: https://n8n.exemplo.com).
N8N_BASE_URL=

# URL do webhook específico usado para disparar/consumir workflows (ex.:
# https://n8n.exemplo.com/webhook/sispat-agu).
N8N_WEBHOOK_URL=

# Chave de API do n8n externo. Segredo — nunca versionar com valor real.
N8N_API_KEY=

# Feature flag: mantenha "false" até a integração estar pronta e validada.
N8N_INTEGRATION_ENABLED=false

# Timeout (segundos) para requisições HTTP ao n8n externo.
N8N_REQUEST_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Geral / Infraestrutura
# -----------------------------------------------------------------------------
# Fuso horário da unidade Palmas/TO. Banco em UTC; UI converte para este TZ.
TZ=America/Araguaina

# Origens permitidas para CORS no backend (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# -----------------------------------------------------------------------------
# Infraestrutura / CloudPanel (VPS Hostinger)
# -----------------------------------------------------------------------------
# Portas locais (127.0.0.1) onde backend/frontend escutam nesta VPS. O
# CloudPanel (com seu próprio Nginx) faz o reverse proxy público e a
# terminação TLS, encaminhando para estas portas — ver
# infra/cloudpanel/vhost.conf.example. NUNCA vincular estas portas a 0.0.0.0.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Limites de recursos dos containers (opcionais; padrões no docker-compose.yml).
# BACKEND_CPUS=1.0
# BACKEND_MEMORY=768M
# FRONTEND_CPUS=1.0
# FRONTEND_MEMORY=512M
# WORKER_CPUS=1.0
# WORKER_MEMORY=768M
# REDIS_CPUS=0.5
# REDIS_MEMORY=256M

# IP(s) de proxy confiável(eis), separados por vírgula, usados pela aplicação
# para decidir em quais cabeçalhos X-Forwarded-For/X-Forwarded-Proto/
# X-Real-IP confiar (ex.: via ProxyFix no Flask, configuração equivalente no
# Next.js). O valor padrão (127.0.0.1) assume o CloudPanel na mesma VPS;
# ajuste para o IP real do proxy (CloudPanel e/ou Cloudflare, se usado como
# camada adicional) quando o ambiente de produção for configurado.
TRUSTED_PROXY_IPS=127.0.0.1

# -----------------------------------------------------------------------------
# Frontend Next.js (variáveis públicas — NUNCA incluir segredos aqui)
# -----------------------------------------------------------------------------
# URL pública da API backend, consumida pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost/api

# Apenas valores públicos do Supabase (nunca a Service Role Key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL local de desenvolvimento (opcional — ver docker-compose.dev.yml)
# Usado APENAS pelo serviço "postgres-dev" (profile "dev-db"). Não é a fonte
# de verdade do sistema; não usar em produção.
# -----------------------------------------------------------------------------
POSTGRES_DEV_USER=sispat_dev
# Sem valor padrão: defina uma senha local (vazio => o container não inicia).
POSTGRES_DEV_PASSWORD=
POSTGRES_DEV_PORT=5432
DEBUGPY_PORT=5678
POSTGRES_DEV_DB=sispat_dev
