# =============================================================================
# SISPAT-AGU — infra/cloudpanel/vhost.conf.example
# =============================================================================
# MODELO DE REFERÊNCIA — NÃO é configuração real de nenhum servidor e NÃO é
# aplicado automaticamente. Copie o conteúdo relevante para o editor de Vhost
# do CloudPanel (Sites > [site] > Vhost), ADAPTANDO domínio, portas e caminhos
# de certificado (gerenciados pelo próprio CloudPanel). Revise com
# `nginx -t` antes de recarregar. Implantação só com autorização explícita.
#
# Contexto (ver docker-compose.yml e .env.example):
#   - O Nginx do CloudPanel é o ÚNICO proxy público (80/443, TLS).
#   - Backend Flask: 127.0.0.1:<BACKEND_PORT> (padrão 8000).
#   - Frontend Next.js: 127.0.0.1:<FRONTEND_PORT> (padrão 3000).
#   - Cloudflare (DNS/HTTPS/proteção) fica na frente do CloudPanel.
#   VERSÃO EM USO em ueato.revizzicar.com.br: vhost.ueato-cloudpanel.conf
#   (modo "Allow traffic from Cloudflare only" do CloudPanel: usa
#   $http_cf_connecting_ip em vez de set_real_ip_from/real_ip_header e NÃO
#   inclui /etc/nginx/global_settings). Ver docs/deploy/ROTEIRO_VPS_ueato.md.
#   Substitua <BACKEND_PORT>/<FRONTEND_PORT> por valores literais — o
#   CloudPanel não interpreta variáveis de ambiente neste editor.
#   Este modelo NÃO usa `include` de arquivos externos: todos os blocos de proxy
#   são literais, então `nginx -t` não depende de nenhum snippet.
#
# Endurecimento aplicado neste modelo (docs/security/evidence/devsecops.md):
#   - IP real do cliente SOMENTE a partir de faixas confiáveis da Cloudflare
#     (real_ip); X-Forwarded-For é SOBRESCRITO (não concatenado) para que o
#     ProxyFix(x_for=1) do Flask enxergue o IP real e não um valor forjado.
#   - Cabeçalhos de segurança com UM ÚNICO emissor por cabeçalho (tabela abaixo).
#   - Limite de corpo (client_max_body_size) coerente com
#     MAX_CONTENT_LENGTH_BYTES do Flask; timeouts e buffers limitados.
#   - Rate limit por IP (geral da API, rotas sensíveis e importação).
#   - Bloqueio de arquivos ocultos (.env, .git) e métodos não usados.
# =============================================================================

# -----------------------------------------------------------------------------
# QUEM EMITE O QUÊ (M2). Regra: cada cabeçalho tem exatamente um emissor.
# add_header em um location SUBSTITUI os do nível server, por isso este modelo
# NÃO usa add_header de segurança em lugar nenhum (opção mais simples).
#
# Cabeçalho                    /api/ (Flask, app/__init__.py)  demais rotas (Next.js)         Nginx
# Strict-Transport-Security    Flask (31536000)                Next (next.config.ts, 63072000) nunca
# X-Content-Type-Options       Flask                           Next                            nunca
# X-Frame-Options              Flask                           Next                            nunca
# Referrer-Policy              Flask (no-referrer)             Next (no-referrer em            nunca
#                                                              /ativar-conta; nas demais
#                                                              strict-origin-when-cross-origin)
# Content-Security-Policy      Flask (default-src 'none')      Next middleware (com nonce)     nunca
# Permissions-Policy / COOP    Flask                           Next                            nunca
# Cache-Control / Pragma       Flask (no-store)                Next                            nunca
#
# Limitação aceita: respostas geradas pelo próprio Nginx (429, 502, 504) saem
# sem esses cabeçalhos. NÃO ative "HSTS" nas configurações da Cloudflare: seria
# um segundo emissor (duplicaria o HSTS da origem).
#
# CRITÉRIO DE ACEITAÇÃO (de outra máquina, após o deploy; cada contagem = 1):
#   curl -sI https://ueato.revizzicar.com.br/ativar-conta | grep -ic '^referrer-policy'
#   curl -sI https://ueato.revizzicar.com.br/ativar-conta | grep -i  '^referrer-policy'   # no-referrer
#   curl -sI https://ueato.revizzicar.com.br/ativar-conta | grep -ic '^strict-transport-security'
#   curl -sI https://ueato.revizzicar.com.br/api/health   | grep -ic '^strict-transport-security'
#   curl -sI https://ueato.revizzicar.com.br/api/health   | grep -ic '^referrer-policy'
# Qualquer contagem diferente de 1 (ou valor diferente de no-referrer em
# /ativar-conta) reprova o deploy.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# (Contexto http) Zonas de rate limit. No CloudPanel, o arquivo de vhost é
# incluído no contexto http, então estas diretivas podem ficar no topo do
# vhost (fora do bloco server). Se já existirem zonas com o mesmo nome, renomeie.
# -----------------------------------------------------------------------------
limit_req_zone  $binary_remote_addr zone=sispat_api:10m       rate=10r/s;
limit_req_zone  $binary_remote_addr zone=sispat_sensitive:10m rate=10r/m;
# B2: zona PRÓPRIA da importação (prévia + consultas); não reutiliza a sensível.
limit_req_zone  $binary_remote_addr zone=sispat_imports:10m   rate=30r/m;
limit_conn_zone $binary_remote_addr zone=sispat_conn:10m;

server {
    # listen / server_name / ssl_certificate* : mantenha os valores gerados
    # pelo CloudPanel para o domínio. Exemplo ilustrativo:
    # listen 443 ssl; listen [::]:443 ssl; http2 on;
    # server_name ueato.revizzicar.com.br;

    # TLS moderno (se o CloudPanel permitir sobrescrever no vhost).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_tickets off;

    # -------------------------------------------------------------------------
    # IP real do cliente via Cloudflare. Mantenha a lista ATUALIZADA a partir de
    # https://www.cloudflare.com/ips/ (IPv4 e IPv6). Requisições que NÃO vêm
    # dessas faixas mantêm $remote_addr = IP de conexão (sem confiar no header).
    # Restrinja também no firewall da VPS as portas 80/443 às faixas da
    # Cloudflare (evita bypass do WAF acessando o IP de origem).
    # -------------------------------------------------------------------------
    # OBRIGATÓRIO: descomente e preencha com TODAS as faixas atuais de
    # https://www.cloudflare.com/ips-v4 e /ips-v6 (uma diretiva por faixa).
    # Sem isso o CF-Connecting-IP é ignorado e auditoria/rate limit veem o IP
    # da Cloudflare. Não copie listas antigas: baixe na hora do deploy.
    # set_real_ip_from <FAIXA_CLOUDFLARE>;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    # Sem versão do Nginx em respostas/erros.
    server_tokens off;

    # -------------------------------------------------------------------------
    # Limites de requisição (DoS / API4:2023 consumo irrestrito de recursos).
    # client_max_body_size deve ser >= MAX_CONTENT_LENGTH_BYTES do Flask
    # (padrão 1 MiB) e pequeno o bastante para não aceitar uploads abusivos.
    # -------------------------------------------------------------------------
    client_max_body_size        2m;
    client_body_buffer_size     64k;
    client_header_buffer_size   4k;
    large_client_header_buffers 4 16k;
    client_body_timeout         15s;
    client_header_timeout       15s;
    send_timeout                30s;
    keepalive_timeout           30s;
    limit_conn sispat_conn 30;
    limit_req_status  429;
    limit_conn_status 429;

    # -------------------------------------------------------------------------
    # Cabeçalhos de segurança: NENHUM add_header aqui (ver tabela no topo).
    # Next.js emite os do frontend (CSP com nonce em src/middleware.ts) e o
    # Flask emite os da API. HSTS sem "preload" (decisão do dono do domínio).
    # -------------------------------------------------------------------------

    # Nunca servir arquivos ocultos (.env, .git, .htpasswd...).
    location ~ /\.(?!well-known/) {
        deny all;
        return 404;
    }

    # -------------------------------------------------------------------------
    # Rotas sensíveis da API (convites/ativação/MFA): rate limit mais estrito.
    # Bloco de proxy LITERAL (B1): sem include de arquivo externo.
    # -------------------------------------------------------------------------
    location ~ ^/api/v1/(users/invite|users/activate-invite|security/mfa/) {
        limit_req zone=sispat_sensitive burst=5 nodelay;

        proxy_pass http://127.0.0.1:<BACKEND_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # -------------------------------------------------------------------------
    # Foto de perfil (multipart): o Flask limita o arquivo a 2 MiB; o envelope
    # multipart passa disso, então só estas rotas aceitam 3m (UA-INFRA-01).
    # -------------------------------------------------------------------------
    # Regex entre aspas: sem elas o "{36}" quebra o parser do Nginx (nginx -t falha).
    location ~ "^/api/v1/(me|users/[0-9a-fA-F-]{36})/avatar$" {
        client_max_body_size 3m;
        limit_req zone=sispat_api burst=10 nodelay;

        proxy_pass http://127.0.0.1:<BACKEND_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # -------------------------------------------------------------------------
    # Importação (Google Sheets -> prévia): pode levar até ~180 s no gunicorn
    # (--timeout 180). O Nginx espera 190 s (> backend), senão devolve 504.
    # ATENÇÃO (M1): com a Cloudflare proxied o limite de leitura é 100 s
    # (HTTP 524); o 190 s do Nginx nunca é atingido nesse caminho. Ver
    # docs/deploy/ROTEIRO_VPS_ueato.md ("Risco M1").
    # Zona própria (B2): 30 req/min, burst 10 (GET e POST).
    # -------------------------------------------------------------------------
    location ^~ /api/v1/imports/ {
        limit_except GET POST OPTIONS { deny all; }
        limit_req zone=sispat_imports burst=10 nodelay;

        proxy_pass http://127.0.0.1:<BACKEND_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 5s;
        proxy_send_timeout    190s;
        proxy_read_timeout    190s;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # -------------------------------------------------------------------------
    # API do backend Flask — tudo sob /api/ vai para o backend.
    # Cabeçalhos de segurança e Cache-Control: emitidos pelo Flask.
    # -------------------------------------------------------------------------
    location /api/ {
        limit_except GET POST PUT PATCH DELETE OPTIONS { deny all; }
        limit_req zone=sispat_api burst=40 nodelay;

        proxy_pass http://127.0.0.1:<BACKEND_PORT>;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # X-Forwarded-For é SOBRESCRITO com o IP real já resolvido (real_ip) —
        # nunca concatenado ao valor enviado pelo cliente. Coerente com
        # ProxyFix(x_for=1, x_proto=1, x_host=1).
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 5s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;   # importação tem location própria (190 s)
        proxy_buffering on;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;
    }

    # -------------------------------------------------------------------------
    # Frontend Next.js — demais rotas. Cabeçalhos: emitidos pelo Next.js.
    # -------------------------------------------------------------------------
    location / {
        limit_except GET HEAD POST { deny all; }
        limit_req zone=sispat_api burst=80 nodelay;

        proxy_pass http://127.0.0.1:<FRONTEND_PORT>;
        proxy_http_version 1.1;

        # Upgrade/WebSocket ("connection_upgrade" é o map padrão do CloudPanel).
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
        proxy_hide_header X-Powered-By;
    }
}
# =============================================================================
