# =============================================================================
# SISPAT-AGU — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Variáveis de ambiente / segredos — NUNCA versionar
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
google_sheets_credentials*.json

# ---------------------------------------------------------------------------
# Documentos de trabalho locais (IA/design) — não versionados
# ---------------------------------------------------------------------------
# Guias locais do desenvolvedor e do Claude Code (regras do projeto, Design
# System, agentes, skills e settings). Ficam só na máquina do desenvolvedor.
CLAUDE.md
DESIGN.md
.claude
# Next.js
# Next.js - compilação e cache
.next/
.next-*/
**/.next/
**/.next-*/

# Dependências
node_modules/
**/node_modules/

# Arquivos temporários
*.log
*.tsbuildinfo

# Ambiente local
.env
.env.local
.env*.local

# ---------------------------------------------------------------------------
# Documentação sensível — fica só na máquina local
# ---------------------------------------------------------------------------
# Relatórios de auditoria de segurança descrevem vulnerabilidades (inclusive
# pendentes de correção em produção) com PoCs e caminhos de exploração.
# O restante da documentação (README.md, backend/README.md,
# frontend/README.md e demais arquivos em docs/) É versionado.
docs/security/SECURITY_AUDIT.md
docs/security/evidence/
docs/security-audit/

# ---------------------------------------------------------------------------
# Ferramentas locais de agentes
# ---------------------------------------------------------------------------
# Skills de terceiros: reinstaláveis a partir de skills-lock.json.
.agents/skills/

# ---------------------------------------------------------------------------
# Python (backend)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------------------------
# Node / Next.js (frontend)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Docker / dados persistentes locais
# ---------------------------------------------------------------------------
*.pid

# ---------------------------------------------------------------------------
# Editor / SO
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# Relatórios locais de testes/segurança (podem conter caminhos e metadados)
# ---------------------------------------------------------------------------
/reports/
coverage.xml
junit.xml
playwright-report/
test-results/
blob-report/
*.p12
*.pfx
*credentials*.json
secrets/
